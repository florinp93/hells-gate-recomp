+layout(push_constant) uniform PushConstants {
+  // Offset 0 holds the vertex shader rectangle.
+  layout(offset = 16) vec2 render_size;
+  layout(offset = 24) vec2 render_size_inv;
+  layout(offset = 32) vec2 output_size;
+  layout(offset = 40) vec2 output_size_inv;
+  // x = output width / render width, y = min(20, (area ratio)^3).
+  layout(offset = 48) vec2 scale_ratio;
+  layout(offset = 56) float min_lerp_contribution;
+  // 1 discards the history (first frame or after a size change).
+  layout(offset = 60) float reset;
+} pc;
+
+layout(set = 0, binding = 0) uniform texture2D input_color;
+layout(set = 0, binding = 1) uniform sampler input_sampler;
+layout(set = 1, binding = 0) uniform texture2D prev_output;
+layout(set = 1, binding = 1) uniform sampler prev_sampler;
+
+layout(location = 0) out vec4 out_color;
+
+float FastLanczos(float base) {
+  float y = base - 1.0;
+  float y2 = y * y;
+  float y_temp = 0.75 * y + y2;
+  return y_temp * y2;
+}
+
+ivec2 max_input_pos;
+
+vec3 FetchInput(ivec2 pos) {
+  return texelFetch(sampler2D(input_color, input_sampler), clamp(pos, ivec2(0), max_input_pos), 0)
+      .xyz;
+}
+
+void main() {
+  max_input_pos = ivec2(pc.render_size) - ivec2(1);
+
+  float Biasmax_viewportXScale = pc.scale_ratio.x;
+  float scalefactor = pc.scale_ratio.y;
+
+  // The SGSR2 effect always draws to its own image at offset 0.
+  vec2 Hruv = gl_FragCoord.xy * pc.output_size_inv;
+  ivec2 InputPos = ivec2(Hruv * pc.render_size);
+
+  // No motion: the history is read at the same place.
+  vec3 HistoryColor = textureLod(sampler2D(prev_output, prev_sampler), Hruv, 0.0).xyz;
+  // On reset the bound history is a stand-in image; don't let it leak in.
