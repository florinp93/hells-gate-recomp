index 0000000..d9ce3cb
--- /dev/null
+++ b/src/core/fiber_android.cpp
@@ -0,0 +1,109 @@
+/**
+ * @file        core/fiber_android.cpp
+ * @brief       Fiber implementation for Android (aarch64)
+ *
+ * bionic does not provide getcontext/makecontext/swapcontext, so this switches
+ * stacks directly. Callee-saved state per AAPCS64: x19-x28, x29 (fp), x30 (lr),
+ * d8-d15, and sp. x18 is the platform register and is never touched.
+ */
+
+#include <rex/platform.h>
+
+#if REX_PLATFORM_ANDROID && defined(__aarch64__)
+
+#include <rex/thread/fiber.h>
+
+#include <cstdint>
+#include <cstdlib>
+#include <cstring>
+
+extern "C" void rex_fiber_switch(void** save_sp, void* load_sp);
+
+// void rex_fiber_switch(void** save_sp /*x0*/, void* load_sp /*x1*/)
+// Frame layout (176 bytes): x19..x28 @0..72, x29 @80, x30 @88, d8..d15 @96..152.
+__asm__(
+    ".text\n"
+    ".balign 16\n"
+    ".globl rex_fiber_switch\n"
+    ".hidden rex_fiber_switch\n"
+    ".type rex_fiber_switch, %function\n"
+    "rex_fiber_switch:\n"
+    "    sub  sp, sp, #176\n"
+    "    stp  x19, x20, [sp, #0]\n"
+    "    stp  x21, x22, [sp, #16]\n"
+    "    stp  x23, x24, [sp, #32]\n"
+    "    stp  x25, x26, [sp, #48]\n"
+    "    stp  x27, x28, [sp, #64]\n"
+    "    stp  x29, x30, [sp, #80]\n"
+    "    stp  d8,  d9,  [sp, #96]\n"
+    "    stp  d10, d11, [sp, #112]\n"
+    "    stp  d12, d13, [sp, #128]\n"
+    "    stp  d14, d15, [sp, #144]\n"
+    "    mov  x2, sp\n"
+    "    str  x2, [x0]\n"
+    "    mov  sp, x1\n"
+    "    ldp  x19, x20, [sp, #0]\n"
+    "    ldp  x21, x22, [sp, #16]\n"
+    "    ldp  x23, x24, [sp, #32]\n"
+    "    ldp  x25, x26, [sp, #48]\n"
+    "    ldp  x27, x28, [sp, #64]\n"
+    "    ldp  x29, x30, [sp, #80]\n"
+    "    ldp  d8,  d9,  [sp, #96]\n"
+    "    ldp  d10, d11, [sp, #112]\n"
+    "    ldp  d12, d13, [sp, #128]\n"
+    "    ldp  d14, d15, [sp, #144]\n"
+    "    add  sp, sp, #176\n"
+    "    ret\n"
+    ".size rex_fiber_switch, .-rex_fiber_switch\n");
+
+namespace rex::thread {
+
+thread_local Fiber* Fiber::tls_current_ = nullptr;
+
+Fiber* Fiber::ConvertCurrentThread() {
+  auto* f = new Fiber();
+  f->is_thread_fiber_ = true;  // sp_ is filled in on the first switch away
+  tls_current_ = f;
+  return f;
+}
+
+Fiber* Fiber::Create(size_t stack_size, void (*entry)(void*), void* arg) {
+  auto* f = new Fiber();
+  f->entry_ = entry;
+  f->arg_ = arg;
+  f->stack_.resize(stack_size);
+
+  // Build an initial frame that rex_fiber_switch "returns" into Trampoline.
+  uintptr_t top = reinterpret_cast<uintptr_t>(f->stack_.data() + f->stack_.size());
+  top &= ~uintptr_t(15);
+  auto* frame = reinterpret_cast<uint64_t*>(top - 176);
+  std::memset(frame, 0, 176);
+  frame[11] = reinterpret_cast<uint64_t>(&Fiber::Trampoline);  // x30 slot
+  f->sp_ = frame;
+  return f;
+}
+
+/*static*/ void Fiber::Trampoline() {
+  // tls_current_ was updated by SwitchTo before switching here.
+  Fiber* f = tls_current_;
+  f->entry_(f->arg_);
+  // A fiber entry must switch away instead of returning; there is no caller.
+  std::abort();
+}
+
+void Fiber::SwitchTo(Fiber* target) {
+  Fiber* from = tls_current_;
+  tls_current_ = target;
+  rex_fiber_switch(&from->sp_, target->sp_);
+}
+
+void Fiber::Destroy() {
+  if (is_thread_fiber_) {
+    tls_current_ = nullptr;
+  }
+  delete this;
+}
+
+}  // namespace rex::thread
+
+#endif  // REX_PLATFORM_ANDROID && defined(__aarch64__)
