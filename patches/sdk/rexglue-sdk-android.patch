+    if (dladdr(t.pcs[i], &d) && d.dli_fname) {
+      REXLOG_WARN("  quit #{:02} {}+{:#x} {}", i, d.dli_fname,
+                  reinterpret_cast<uintptr_t>(t.pcs[i]) - reinterpret_cast<uintptr_t>(d.dli_fbase),
+                  d.dli_sname ? d.dli_sname : "?");
+    } else {
+      REXLOG_WARN("  quit #{:02} {}", i, t.pcs[i]);
+    }
+  }
+}
