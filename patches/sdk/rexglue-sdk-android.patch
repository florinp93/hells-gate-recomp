diff --git a/src/ui/shaders/sgsr/guest_output_sgsr1_ps.frag b/src/ui/shaders/sgsr/guest_output_sgsr1_ps.frag
new file mode 100644
index 0000000..036f30d
--- /dev/null
+++ b/src/ui/shaders/sgsr/guest_output_sgsr1_ps.frag
@@ -0,0 +1,108 @@
+#version 450
+// Snapdragon Game Super Resolution 1 (spatial), adapted for the guest output
+// presenter from sgsr/v1/include/glsl/sgsr1_shader_mobile.frag.
+//
+// Copyright (c) 2025, Qualcomm Innovation Center, Inc. All rights reserved.
+// SPDX-License-Identifier: BSD-3-Clause
+//
+// Regenerate the header with:
+//   glslangValidator -V --vn guest_output_sgsr1_ps -o ../vulkan_spirv/guest_output_sgsr1_ps.h guest_output_sgsr1_ps.frag
+
+// RGBA operation mode: green is the luma proxy.
+#define SGSR_MODE 1
+#define SGSR_EDGE_THRESHOLD (8.0 / 255.0)
+
+layout(push_constant) uniform PushConstants {
+  // Offset 0 holds the vertex shader rectangle.
+  layout(offset = 16) ivec2 output_offset;
+  layout(offset = 24) vec2 output_size_inv;
+  // xy = 1 / input size, zw = input size.
+  layout(offset = 32) vec4 viewport_info;
+  layout(offset = 48) float edge_sharpness;
+} pc;
+
+layout(set = 0, binding = 0) uniform texture2D src_texture;
+layout(set = 0, binding = 1) uniform sampler src_sampler;
+
+layout(location = 0) out vec4 out_color;
+
+float fastLanczos2(float x) {
+  float wA = x - 4.0;
+  float wB = x * wA - wA;
+  wA *= wA;
+  return wB * wA;
+}
+
+vec2 weightY(float dx, float dy, float c, float std_) {
+  float x = ((dx * dx) + (dy * dy)) * 0.55 + clamp(abs(c) * std_, 0.0, 1.0);
+  float w = fastLanczos2(x);
+  return vec2(w, w * c);
+}
+
+void main() {
+  vec2 uv = (gl_FragCoord.xy - vec2(pc.output_offset)) * pc.output_size_inv;
+  vec4 viewport_info = pc.viewport_info;
+
+  vec4 color;
+  color.xyz = textureLod(sampler2D(src_texture, src_sampler), uv, 0.0).xyz;
+  color.w = 0.0;
+
+  vec2 imgCoord = (uv * viewport_info.zw) + vec2(-0.5, 0.5);
+  vec2 imgCoordPixel = floor(imgCoord);
+  vec2 coord = imgCoordPixel * viewport_info.xy;
+  vec2 pl = imgCoord - imgCoordPixel;
+  vec4 left = textureGather(sampler2D(src_texture, src_sampler), coord, SGSR_MODE);
+
+  float edgeVote = abs(left.z - left.y) + abs(color[SGSR_MODE] - left.y) +
+                   abs(color[SGSR_MODE] - left.z);
+  if (edgeVote > SGSR_EDGE_THRESHOLD) {
+    coord.x += viewport_info.x;
+
+    vec4 right = textureGather(sampler2D(src_texture, src_sampler),
+                               coord + vec2(viewport_info.x, 0.0), SGSR_MODE);
+    vec4 upDown;
+    upDown.xy = textureGather(sampler2D(src_texture, src_sampler),
+                              coord + vec2(0.0, -viewport_info.y), SGSR_MODE).wz;
+    upDown.zw = textureGather(sampler2D(src_texture, src_sampler),
+                              coord + vec2(0.0, viewport_info.y), SGSR_MODE).yx;
+
+    float mean = (left.y + left.z + right.x + right.w) * 0.25;
+    left = left - vec4(mean);
+    right = right - vec4(mean);
+    upDown = upDown - vec4(mean);
+    color.w = color[SGSR_MODE] - mean;
+
+    float sum = (((((abs(left.x) + abs(left.y)) + abs(left.z)) + abs(left.w)) +
+                  (((abs(right.x) + abs(right.y)) + abs(right.z)) + abs(right.w))) +
+                 (((abs(upDown.x) + abs(upDown.y)) + abs(upDown.z)) + abs(upDown.w)));
+    float std_ = 2.181818 / sum;
+
+    vec2 aWY = weightY(pl.x, pl.y + 1.0, upDown.x, std_);
+    aWY += weightY(pl.x - 1.0, pl.y + 1.0, upDown.y, std_);
+    aWY += weightY(pl.x - 1.0, pl.y - 2.0, upDown.z, std_);
+    aWY += weightY(pl.x, pl.y - 2.0, upDown.w, std_);
+    aWY += weightY(pl.x + 1.0, pl.y - 1.0, left.x, std_);
+    aWY += weightY(pl.x, pl.y - 1.0, left.y, std_);
+    aWY += weightY(pl.x, pl.y, left.z, std_);
+    aWY += weightY(pl.x + 1.0, pl.y, left.w, std_);
+    aWY += weightY(pl.x - 1.0, pl.y - 1.0, right.x, std_);
+    aWY += weightY(pl.x - 2.0, pl.y - 1.0, right.y, std_);
+    aWY += weightY(pl.x - 2.0, pl.y, right.z, std_);
+    aWY += weightY(pl.x - 1.0, pl.y, right.w, std_);
+
+    float finalY = aWY.y / aWY.x;
+
+    float maxY = max(max(left.y, left.z), max(right.x, right.w));
+    float minY = min(min(left.y, left.z), min(right.x, right.w));
+    finalY = clamp(pc.edge_sharpness * finalY, minY, maxY);
+
+    float deltaY = finalY - color.w;
+
+    // Smooth high-contrast input.
+    deltaY = clamp(deltaY, -23.0 / 255.0, 23.0 / 255.0);
+
+    color.xyz = clamp(color.xyz + vec3(deltaY), vec3(0.0), vec3(1.0));
+  }
+
+  out_color = vec4(color.xyz, 1.0);
+}
