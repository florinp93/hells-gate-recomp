+// Protection shadow for the guest arena. Reading /proc/self/maps costs a full
+// kernel render of every mapping (thousands on Android) and GPU write-watch
+// faults query protection constantly, so protections set through this file are
+// mirrored here. Pages start unknown and are filled lazily from /proc/self/maps.
+constexpr uint8_t kShadowUnknown = 0xFF;
+std::unique_ptr<std::atomic<uint8_t>[]> g_shadow;
+uintptr_t g_shadow_begin = 0;
+uintptr_t g_shadow_end = 0;
+size_t g_shadow_page = 4096;
+
+// Pages of [base, base+length) that fall in the shadow, as [first, last).
+bool ShadowClip(uintptr_t base, size_t length, size_t& first, size_t& last) {
+  if (!g_shadow || length == 0) return false;
+  uintptr_t b = base, e = base + length;
+  if (e <= g_shadow_begin || b >= g_shadow_end) return false;
+  if (b < g_shadow_begin) b = g_shadow_begin;
+  if (e > g_shadow_end) e = g_shadow_end;
+  first = (b - g_shadow_begin) / g_shadow_page;
+  last = (e - g_shadow_begin + g_shadow_page - 1) / g_shadow_page;
+  return first < last;
+}
+
+void ShadowSet(void* base, size_t length, uint8_t value) {
+  size_t first, last;
+  if (!ShadowClip(reinterpret_cast<uintptr_t>(base), length, first, last)) return;
+  for (size_t i = first; i < last; ++i) g_shadow[i].store(value, std::memory_order_relaxed);
+}
+
+void ShadowFill(const LinuxMapEntry& e) {
+  size_t first, last;
+  if (!ShadowClip(e.start, e.end - e.start, first, last)) return;
+  const uint8_t value = static_cast<uint8_t>(PermsToPageAccess(e.perms));
+  for (size_t i = first; i < last; ++i) {
+    uint8_t expected = kShadowUnknown;
+    g_shadow[i].compare_exchange_strong(expected, value, std::memory_order_relaxed);
+  }
+}
+
+// Known protection of the page holding `address`; run = bytes from `address`
+// with the same protection (bounded scan).
+bool ShadowGet(void* address, PageAccess& access, size_t* run) {
+  const uintptr_t a = reinterpret_cast<uintptr_t>(address);
+  if (!g_shadow || a < g_shadow_begin || a >= g_shadow_end) return false;
+  size_t i = (a - g_shadow_begin) / g_shadow_page;
+  const uint8_t v = g_shadow[i].load(std::memory_order_relaxed);
+  if (v == kShadowUnknown) return false;
+  access = static_cast<PageAccess>(v);
+  if (run) {
+    const size_t pages = (g_shadow_end - g_shadow_begin) / g_shadow_page;
+    size_t j = i + 1;
