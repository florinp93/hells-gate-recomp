+void CommandProcessor::TraceDrawForPass(const reg::VGT_DRAW_INITIATOR& draw_initiator) {
+  PassTraceKey key;
+  for (uint32_t i = 0; i < xenos::kMaxColorRenderTargets; ++i) {
+    auto color_info =
+        register_file_->Get<reg::RB_COLOR_INFO>(reg::RB_COLOR_INFO::rt_register_indices[i]);
+    key.color_base[i] = color_info.color_base;
+    key.color_format[i] = uint32_t(color_info.color_format);
+  }
+  auto depth_info = register_file_->Get<reg::RB_DEPTH_INFO>();
+  key.depth_base = depth_info.depth_base;
+  key.depth_format = uint32_t(depth_info.depth_format);
+  auto surface_info = register_file_->Get<reg::RB_SURFACE_INFO>();
+  key.surface_pitch = surface_info.surface_pitch;
+  key.msaa_samples = uint32_t(surface_info.msaa_samples);
+
+  auto accumulate = [&key, &draw_initiator, this](PassTraceStats& stats) {
+    ++stats.draws;
+    stats.indices += draw_initiator.num_indices;
+    stats.prim_type_mask |= uint32_t(1) << uint32_t(draw_initiator.prim_type);
+    if (active_vertex_shader_) {
+      stats.shader_hashes.insert(active_vertex_shader_->ucode_data_hash());
+    }
+    if (active_pixel_shader_) {
+      stats.shader_hashes.insert(active_pixel_shader_->ucode_data_hash());
+    }
+  };
+
+  accumulate(pass_trace_[key]);
+
+  if (pass_trace_timeline_.empty() ||
+      std::memcmp(&pass_trace_timeline_.back().key, &key, sizeof(key)) != 0) {
+    pass_trace_timeline_.push_back({key, {}});
+  }
+  accumulate(pass_trace_timeline_.back().stats);
+}
+
+void CommandProcessor::DumpPassTrace() {
+  REXGPU_INFO("PASS-TRACE frame {}: {} segments, {} groups", swap_counter(),
+              pass_trace_timeline_.size(), pass_trace_.size());
+  uint32_t seg_index = 0;
+  for (const auto& seg : pass_trace_timeline_) {
+    const auto& key = seg.key;
+    const auto& stats = seg.stats;
+    REXGPU_INFO(
+        "  seg {}: color=[{:X}:f{} {:X}:f{} {:X}:f{} {:X}:f{}] depth={:X}:f{} pitch={} "
+        "msaa={} draws={} indices={} prims=0x{:02X} shaders={}",
+        seg_index++, key.color_base[0], key.color_format[0], key.color_base[1],
+        key.color_format[1], key.color_base[2], key.color_format[2], key.color_base[3],
+        key.color_format[3], key.depth_base, key.depth_format, key.surface_pitch,
+        key.msaa_samples, stats.draws, stats.indices, stats.prim_type_mask,
+        stats.shader_hashes.size());
+  }
+  pass_trace_.clear();
+  pass_trace_timeline_.clear();
+}
