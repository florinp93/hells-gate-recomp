+bool VulkanPipelineCache::TryLoadCachedSpirvTranslation(
+    VulkanShader::VulkanTranslation& translation) {
+  VulkanShader& shader = static_cast<VulkanShader&>(translation.shader());
+  SpvCacheKey key{shader.ucode_data_hash(), translation.modification()};
+  std::lock_guard<std::mutex> lock(spv_cache_mutex_);
+  auto it = spv_cache_.find(key);
+  if (it == spv_cache_.end()) {
+    return false;
+  }
+  const SpvCacheEntry& entry = it->second;
+  shader.SetCachedBindings(entry.texture_bindings.data(),
+                           entry.texture_bindings.size(),
+                           entry.sampler_bindings.data(),
+                           entry.sampler_bindings.size(),
+                           entry.used_texture_mask);
+  translation.AdoptCachedResult(entry.spirv.data(), entry.spirv.size(),
+                                entry.is_valid);
+  return true;
+}
