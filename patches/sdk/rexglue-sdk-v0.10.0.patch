diff --git a/cmake/rexglue_fidelityfx.cmake b/cmake/rexglue_fidelityfx.cmake
index af35fa8..939a3d1 100644
--- a/cmake/rexglue_fidelityfx.cmake
+++ b/cmake/rexglue_fidelityfx.cmake
@@ -58,6 +58,41 @@ if(NOT fidelityfx_POPULATED)
     FetchContent_Populate(fidelityfx)
 endif()
 
+# llvm-rc does not accept UTF-16 .rc files; the FidelityFX SDK ships the
+# ffx_api_dll.rc with a BOM on some hosts. Convert it to UTF-8 once after
+# population so the resource compiler can process it.
+if(WIN32)
+    set(_ffx_dll_rc "${fidelityfx_SOURCE_DIR}/ffx-api/src/resource/ffx_api_dll.rc")
+    if(EXISTS "${_ffx_dll_rc}")
+        execute_process(
+            COMMAND powershell -NoProfile -Command
+                "$rc = '${_ffx_dll_rc}'; $bytes = [System.IO.File]::ReadAllBytes($rc); if ($bytes.Length -ge 2 -and $bytes[0] -eq 0xFF -and $bytes[1] -eq 0xFE) { $text = [System.IO.File]::ReadAllText($rc, [System.Text.Encoding]::Unicode); [System.IO.File]::WriteAllText($rc, $text, [System.Text.Encoding]::UTF8) }"
+            RESULT_VARIABLE _ffx_dll_rc_conversion
+        )
+    endif()
+endif()
+
+# The shader permutation commands run through /bin/sh. Where that is bash
+# (openSUSE, Fedora, Arch), brace expansion splits -DOPT={0,1} into
+# -DOPT=0 -DOPT=1 and FidelityFX_SC fails with "Macro redefined". Escape the
+# braces once after population so the permutation syntax reaches the tool.
+if(UNIX)
+    set(_ffx_compile_shaders "${fidelityfx_SOURCE_DIR}/sdk/include/FidelityFX/gpu/CMakeCompileShaders.txt")
+    if(EXISTS "${_ffx_compile_shaders}")
+        file(READ "${_ffx_compile_shaders}" _ffx_compile_shaders_text)
+        string(FIND "${_ffx_compile_shaders_text}" [=[REPLACE "{" "\\{" SC_ARGS]=] _ffx_braces_escaped)
+        if(_ffx_braces_escaped EQUAL -1)
+            string(REPLACE
+                [=[set(SC_ARGS ${BASE_ARGS} ${API_BASE_ARGS} ${PERMUTATION_ARGS})]=]
+                [=[set(SC_ARGS ${BASE_ARGS} ${API_BASE_ARGS} ${PERMUTATION_ARGS})
+		string(REPLACE "{" "\\{" SC_ARGS "${SC_ARGS}")
+		string(REPLACE "}" "\\}" SC_ARGS "${SC_ARGS}")]=]
+                _ffx_compile_shaders_text "${_ffx_compile_shaders_text}")
+            file(WRITE "${_ffx_compile_shaders}" "${_ffx_compile_shaders_text}")
+        endif()
+    endif()
+endif()
+
 set(REXGLUE_FIDELITYFX_SOURCE_DIR "${fidelityfx_SOURCE_DIR}" CACHE INTERNAL
     "Root of the fetched FidelityFX SDK source tree")
 
