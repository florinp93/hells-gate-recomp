<Window x:Class="DantesInferno.Launcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dante's Inferno" Height="660" Width="1060"
        WindowStyle="None" ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundDark}"
        BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1"
        TextOptions.TextFormattingMode="Display">
    <Window.Resources>
        <Style x:Key="NavIcon" TargetType="Path">
            <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
            <Setter Property="StrokeThickness" Value="1.6" />
            <Setter Property="StrokeLineJoin" Value="Round" />
            <Setter Property="StrokeStartLineCap" Value="Round" />
            <Setter Property="StrokeEndLineCap" Value="Round" />
            <Setter Property="Width" Value="18" />
            <Setter Property="Height" Value="18" />
            <Setter Property="Stretch" Value="Uniform" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>
        <Style x:Key="NavLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Margin" Value="0,5,0,0" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="MaxWidth" Value="74" />
        </Style>
        <Style x:Key="StatusRow" TargetType="StackPanel">
            <Setter Property="Orientation" Value="Horizontal" />
            <Setter Property="Margin" Value="0,4" />
        </Style>
        <Style x:Key="StatusDot" TargetType="Ellipse">
            <Setter Property="Width" Value="9" />
            <Setter Property="Height" Value="9" />
            <Setter Property="Margin" Value="0,0,10,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Fill" Value="{StaticResource SuccessBrush}" />
        </Style>
        <Style x:Key="SettingRowLabel" TargetType="Label" BasedOn="{StaticResource {x:Type Label}}">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="32" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border x:Name="TitleBar" Background="{StaticResource BackgroundRail}" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                    <TextBlock Text="DANTE'S INFERNO" FontFamily="{StaticResource TitleFont}" FontSize="12"
                               Foreground="{StaticResource GoldBrush}" VerticalAlignment="Center" />
                    <TextBlock x:Name="VersionText" Text="" FontSize="11" Foreground="{StaticResource TextMutedBrush}"
                               Margin="10,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="MinimizeButton" Style="{StaticResource TitleBarButton}" Click="MinimizeButton_Click">
                        <Path Data="M0,0 H10" Stroke="{StaticResource TextSecondaryBrush}" StrokeThickness="1.2" />
                    </Button>
                    <Button x:Name="ExitButton" Style="{StaticResource CloseButton}" Click="ExitButton_Click">
                        <Path Data="M0,0 L10,10 M10,0 L0,10" Stroke="{StaticResource TextSecondaryBrush}" StrokeThickness="1.2" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="80" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Background="{StaticResource BackgroundRail}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
                <StackPanel Margin="0,8,0,0">
                    <RadioButton x:Name="NavPlay" Style="{StaticResource NavButton}" IsChecked="True" Checked="Nav_Checked" Tag="0">
                        <StackPanel>
                            <Path Style="{StaticResource NavIcon}" Data="M3,1 L15,9 L3,17 Z" />
                            <TextBlock Style="{StaticResource NavLabel}" Text="{Binding Header, ElementName=TabPlay}" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavSettings" Style="{StaticResource NavButton}" Checked="Nav_Checked" Tag="3">
                        <StackPanel>
                            <Path Style="{StaticResource NavIcon}"
                                  Data="M1,4 H4 M8,4 H17 M1,13 H10 M14,13 H17 M6,4 m-2,0 a2,2 0 1,0 4,0 a2,2 0 1,0 -4,0 M12,13 m-2,0 a2,2 0 1,0 4,0 a2,2 0 1,0 -4,0" />
                            <TextBlock Style="{StaticResource NavLabel}" Text="{Binding Header, ElementName=TabSettings}" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavControls" Style="{StaticResource NavButton}" Checked="Nav_Checked" Tag="2">
                        <StackPanel>
                            <Path Style="{StaticResource NavIcon}"
                                  Data="M1,3 H17 V15 H1 Z M4,6.5 H5 M7.5,6.5 H8.5 M11,6.5 H12 M14,6.5 H14.5 M4,9.5 H5 M7.5,9.5 H8.5 M11,9.5 H12 M14,9.5 H14.5 M5,12.5 H13" />
                            <TextBlock Style="{StaticResource NavLabel}" Text="{Binding Header, ElementName=TabControls}" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavDlc" Style="{StaticResource NavButton}" Checked="Nav_Checked" Tag="1">
                        <StackPanel>
                            <Path Style="{StaticResource NavIcon}"
                                  Data="M9,1 L17,5 L17,13 L9,17 L1,13 L1,5 Z M1,5 L9,9 L17,5 M9,9 L9,17" />
                            <TextBlock Style="{StaticResource NavLabel}" Text="{Binding Header, ElementName=TabDlc}" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavUpdates" Style="{StaticResource NavButton}" Checked="Nav_Checked" Tag="4">
                        <StackPanel>
                            <Path Style="{StaticResource NavIcon}" Data="M16,9 A7,7 0 1,1 13.9,4 M14,0.5 V4.5 H10" />
                            <TextBlock Style="{StaticResource NavLabel}" Text="{Binding Header, ElementName=TabUpdates}" />
                        </StackPanel>
                    </RadioButton>
                </StackPanel>
            </Border>

            <TabControl x:Name="MainTabControl" Grid.Column="1" ItemContainerStyle="{StaticResource HiddenTab}">

                <TabItem x:Name="TabPlay" Header="PLAY">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="340" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Image x:Name="BannerImage" Stretch="UniformToFill" VerticalAlignment="Top" HorizontalAlignment="Center" />
                        <Rectangle>
                            <Rectangle.Fill>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#00120C0A" Offset="0.55" />
                                    <GradientStop Color="#FF120C0A" Offset="1" />
                                </LinearGradientBrush>
                            </Rectangle.Fill>
                        </Rectangle>
                        <Rectangle>
                            <Rectangle.Fill>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#00120C0A" Offset="0.7" />
                                    <GradientStop Color="#E6120C0A" Offset="1" />
                                </LinearGradientBrush>
                            </Rectangle.Fill>
                        </Rectangle>

                        <Grid Grid.Column="1" Margin="28,34,32,18">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <StackPanel>
                                <TextBlock Text="DANTE'S" FontFamily="{StaticResource TitleFont}" FontSize="18"
                                           Foreground="{StaticResource GoldBrush}" />
                                <TextBlock Text="INFERNO" FontFamily="{StaticResource TitleFont}" FontSize="52"
                                           Foreground="{StaticResource TextBrush}" Margin="0,-6,0,0" />
                                <TextBlock x:Name="PlaySubtitleText" Text="Ready to enter the Nine Circles." FontSize="14"
                                           Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0" />
                            </StackPanel>

                            <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,24,0,0" HorizontalAlignment="Left" MinWidth="380">
                                <StackPanel>
                                    <StackPanel Style="{StaticResource StatusRow}">
                                        <Ellipse x:Name="StatusGameDot" Style="{StaticResource StatusDot}" />
                                        <TextBlock x:Name="PlayStatusText" Text="" FontSize="13" TextWrapping="Wrap" MaxWidth="440" />
                                    </StackPanel>
                                    <StackPanel Style="{StaticResource StatusRow}">
                                        <Ellipse x:Name="StatusTuDot" Style="{StaticResource StatusDot}" />
                                        <TextBlock x:Name="StatusTuText" Text="" FontSize="13" />
                                    </StackPanel>
                                    <StackPanel Style="{StaticResource StatusRow}">
                                        <Ellipse x:Name="StatusDlcDot" Style="{StaticResource StatusDot}" />
                                        <TextBlock x:Name="StatusDlcText" Text="" FontSize="13" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <StackPanel Grid.Row="2" VerticalAlignment="Center" Margin="0,18,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <Button x:Name="PlayButton" Style="{StaticResource PlayButtonStyle}" Content="PLAY" Click="PlayButton_Click" />
                                    <StackPanel VerticalAlignment="Center" Margin="20,0,0,0">
                                        <TextBlock x:Name="SettingsSummaryText" Text="" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                                        <Button x:Name="ChangeSettingsButton" Style="{StaticResource LinkButton}" Margin="0,4,0,0"
                                                Foreground="{StaticResource AccentTextBrush}" Click="ChangeSettings_Click">
                                            <TextBlock x:Name="ChangeSettingsText" Text="Change settings" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                        </Button>
                                    </StackPanel>
                                </StackPanel>
                                <TextBlock x:Name="PlayNoteText" Text="" Style="{StaticResource Hint}" Margin="0,12,0,0" />
                            </StackPanel>

                            <Border Grid.Row="4" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,12,0,0">
                                <Grid>
                                    <StackPanel Orientation="Horizontal">
                                        <Button x:Name="ReportProblemButton" Style="{StaticResource LinkButton}" Content="Report a problem" Click="ReportProblem_Click" />
                                        <Button x:Name="ExportSavesButton" Style="{StaticResource LinkButton}" Content="Export saves" Margin="22,0,0,0" Click="ExportSaves_Click" />
                                    </StackPanel>
                                    <Button x:Name="SupportButton" Style="{StaticResource LinkButton}" Content="Support the Developer"
                                            HorizontalAlignment="Right" Click="SupportButton_Click" />
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                </TabItem>

                <TabItem x:Name="TabDlc" Header="DLC">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                  AllowDrop="True" Drop="DlcTab_Drop" DragOver="DlcTab_DragOver" Background="Transparent">
                        <StackPanel Margin="32,28,32,24">
                            <TextBlock x:Name="DlcTitleText" Style="{StaticResource PageTitle}" Text="Downloadable Content" />
                            <TextBlock x:Name="DlcDescriptionText" Style="{StaticResource PageSubtitle}" Text="" />

                            <Border x:Name="DlcDropZone" CornerRadius="8" Padding="20" Margin="0,0,0,14" Background="{StaticResource BackgroundPanel}">
                                <Border.BorderBrush>
                                    <DrawingBrush Viewport="0,0,12,12" ViewportUnits="Absolute" TileMode="Tile">
                                        <DrawingBrush.Drawing>
                                            <GeometryDrawing Brush="{StaticResource BorderStrongBrush}">
                                                <GeometryDrawing.Geometry>
                                                    <GeometryGroup>
                                                        <RectangleGeometry Rect="0,0,6,6" />
                                                        <RectangleGeometry Rect="6,6,6,6" />
                                                    </GeometryGroup>
                                                </GeometryDrawing.Geometry>
                                            </GeometryDrawing>
                                        </DrawingBrush.Drawing>
                                    </DrawingBrush>
                                </Border.BorderBrush>
                                <Border.BorderThickness>1.5</Border.BorderThickness>
                                <Grid>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Path Data="M9,1 L17,5 L17,13 L9,17 L1,13 L1,5 Z M1,5 L9,9 L17,5 M9,9 L9,17" Width="30" Height="30" Stretch="Uniform"
                                              Stroke="{StaticResource GoldBrush}" StrokeThickness="1.4" StrokeLineJoin="Round" Margin="0,0,16,0" />
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock x:Name="DropDlcTitleText" Text="" FontSize="14" />
                                            <TextBlock x:Name="DropDlcHintText" Text="" Style="{StaticResource Hint}" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </StackPanel>
                                    <Button x:Name="InstallDlcButton" Style="{StaticResource PrimaryButton}" Content="Install DLC..."
                                            HorizontalAlignment="Right" VerticalAlignment="Center" Click="InstallDlc_Click" />
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                                <Grid>
                                    <TextBlock x:Name="DlcStatusText" Text="" FontSize="13" LineHeight="22" TextWrapping="Wrap" Margin="0,0,180,0" />
                                    <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top">
                                        <Button x:Name="OpenDlcFolderButton" Content="Open DLC Folder" Click="OpenDlcFolder_Click" Margin="0,0,0,8" />
                                        <Button x:Name="OpenTuFolderButton" Content="Open TU Folder" Click="OpenTuFolder_Click" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock x:Name="TrialsServerTitleText" Text="" FontFamily="{StaticResource TitleFont}" FontSize="15"
                                               Foreground="{StaticResource GoldBrush}" Margin="0,0,0,6" />
                                    <TextBlock x:Name="TrialsServerMessageText" Text="" TextWrapping="Wrap" FontSize="13"
                                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,12" />
                                    <Button x:Name="TrialsServerButton" Content="Support on Ko-Fi" HorizontalAlignment="Left" Click="SupportButton_Click" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem x:Name="TabControls" Header="CONTROLS">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="32,28,32,24">
                            <TextBlock x:Name="ControlsTitleText" Style="{StaticResource PageTitle}" Text="Keyboard Bindings" />
                            <TextBlock x:Name="ControlsHintText" Style="{StaticResource PageSubtitle}" Text="" />

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="14" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <GroupBox x:Name="GroupActions" Header="Actions">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Label x:Name="LabelA" Grid.Row="0" Content="A (Interact):" />
                                            <TextBox Grid.Row="0" x:Name="KeyA" Style="{StaticResource KeyField}" PreviewKeyDown="KeyField_PreviewKeyDown" />
                                            <Label x:Name="LabelB" Grid.Row="1" Content="B (Cancel):" />
                                            <TextBox Grid.Row="1" x:Name="KeyB" Style="{StaticResource KeyField}" PreviewKeyDown="KeyField_PreviewKeyDown" />
                                            <Label x:Name="LabelX" Grid.Row="2" Content="X (Attack):" />
                                            <TextBox Grid.Row="2" x:Name="KeyX" Style="{StaticResource KeyField}" PreviewKeyDown="KeyField_PreviewKeyDown" />
                                            <Label x:Name="LabelY" Grid.Row="3" Content="Y (Magic):" />
                                            <TextBox Grid.Row="3" x:Name="KeyY" Style="{StaticResource KeyField}" PreviewKeyDown="KeyField_PreviewKeyDown" />
                                            <Label x:Name="LabelBack" Grid.Row="4" Content="Back:" />
                                            <TextBox Grid.Row="4" x:Name="KeyBack" Style="{StaticResource KeyField}" PreviewKeyDown="KeyField_PreviewKeyDown" />
                                            <Label x:Name="LabelStart" Grid.Row="5" Content="Start:" />
                                            <TextBox Grid.Row="5" x:Name="KeyStart" Style="{StaticResource KeyField}" PreviewKeyDown="KeyField_PreviewKeyDown" />
                                        </Grid>
                                    </GroupBox>
                                    <GroupBox x:Name="GroupShoulders" Header="Shoulders / Triggers">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Label x:Name="LabelLeftShoulder" Grid.Row="0" Content="Left Shoulder:" />
                                            <TextBox Grid.Row="0" x:Name="KeyLS" Style="{StaticResource KeyField}" PreviewKeyDown="KeyField_PreviewKeyDown" />
                                            <Label x:Name="LabelRightShoulder" Grid.Row="1" Content="Right Shoulder:" />
                                            <TextBox Grid.Row="1" x:Name="KeyRS" Style="{StaticResource KeyField}" PreviewKeyDown="KeyField_PreviewKeyDown" />
                                            <Label x:Name="LabelLeftTrigger" Grid.Row="2" Content="Left Trigger:" />
                                            <TextBox Grid.Row="2" x:Name="KeyLT" Style="{StaticResource KeyField}" PreviewKeyDown="KeyField_PreviewKeyDown" />
                                            <Label x:Name="LabelRightTrigger" Grid.Row="3" Content="Right Trigger:" />
                                            <TextBox Grid.Row="3" x:Name="KeyRT" Style="{StaticResource KeyField}" PreviewKeyDown="KeyField_PreviewKeyDown" />
                                        </Grid>
                                    </GroupBox>
                                    <GroupBox x:Name="GroupDpad" Header="D-Pad">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Label x:Name="LabelDUp" Grid.Row="0" Content="Up:" />
                                            <TextBox Grid.Row="0" x:Name="KeyDUp" Style="{StaticResource KeyField}" PreviewKeyDown="KeyField_PreviewKeyDown" />
                                            <Label x:Name="LabelDDown" Grid.Row="1" Content="Down:" />
                                            <TextBox Grid.Row="1" x:Name="KeyDDown" Style="{StaticResource KeyField}" PreviewKeyDown="KeyField_PreviewKeyDown" />
                                            <Label x:Name="LabelDLeft" Grid.Row="2" Content="Left:" />
                                            <TextBox Grid.Row="2" x:Name="KeyDLeft" Style="{StaticResource KeyField}" PreviewKeyDown="KeyField_PreviewKeyDown" />
                                            <Label x:Name="LabelDRight" Grid.Row="3" Content="Right:" />
                                            <TextBox Grid.Row="3" x:Name="KeyDRight" Style="{StaticResource KeyField}" PreviewKeyDown="KeyField_PreviewKeyDown" />
                                        </Grid>
                                    </GroupBox>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <GroupBox x:Name="GroupLeftStick" Header="Left Stick (Movement)">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Label x:Name="LabelLUp" Grid.Row="0" Content="Up:" />
                                            <TextBox Grid.Row="0" x:Name="KeyLUp" Style="{StaticResource KeyField}" PreviewKeyDown="KeyField_PreviewKeyDown" />
                                            <Label x:Name="LabelLDown" Grid.Row="1" Content="Down:" />
                                            <TextBox Grid.Row="1" x:Name="KeyLDown" Style="{StaticResource KeyField}" PreviewKeyDown="KeyField_PreviewKeyDown" />
                                            <Label x:Name="LabelLLeft" Grid.Row="2" Content="Left:" />
                                            <TextBox Grid.Row="2" x:Name="KeyLLeft" Style="{StaticResource KeyField}" PreviewKeyDown="KeyField_PreviewKeyDown" />
                                            <Label x:Name="LabelLRight" Grid.Row="3" Content="Right:" />
                                            <TextBox Grid.Row="3" x:Name="KeyLRight" Style="{StaticResource KeyField}" PreviewKeyDown="KeyField_PreviewKeyDown" />
                                            <Label x:Name="LabelLPress" Grid.Row="4" Content="Press (Sprint):" />
                                            <TextBox Grid.Row="4" x:Name="KeyLPress" Style="{StaticResource KeyField}" PreviewKeyDown="KeyField_PreviewKeyDown" />
                                        </Grid>
                                    </GroupBox>
                                    <GroupBox x:Name="GroupRightStick" Header="Right Stick (Camera)">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Label x:Name="LabelRUp" Grid.Row="0" Content="Up:" />
                                            <TextBox Grid.Row="0" x:Name="KeyRUp" Style="{StaticResource KeyField}" PreviewKeyDown="KeyField_PreviewKeyDown" />
                                            <Label x:Name="LabelRDown" Grid.Row="1" Content="Down:" />
                                            <TextBox Grid.Row="1" x:Name="KeyRDown" Style="{StaticResource KeyField}" PreviewKeyDown="KeyField_PreviewKeyDown" />
                                            <Label x:Name="LabelRLeft" Grid.Row="2" Content="Left:" />
                                            <TextBox Grid.Row="2" x:Name="KeyRLeft" Style="{StaticResource KeyField}" PreviewKeyDown="KeyField_PreviewKeyDown" />
                                            <Label x:Name="LabelRRight" Grid.Row="3" Content="Right:" />
                                            <TextBox Grid.Row="3" x:Name="KeyRRight" Style="{StaticResource KeyField}" PreviewKeyDown="KeyField_PreviewKeyDown" />
                                            <Label x:Name="LabelRPress" Grid.Row="4" Content="Press:" />
                                            <TextBox Grid.Row="4" x:Name="KeyRPress" Style="{StaticResource KeyField}" PreviewKeyDown="KeyField_PreviewKeyDown" />
                                        </Grid>
                                    </GroupBox>
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,4,0,0">
                                <TextBlock x:Name="BindingsAppliedNoteText" Style="{StaticResource Hint}" Text="" VerticalAlignment="Center" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button x:Name="ResetKeybindsButton" Content="Reset to Default" Click="ResetKeybinds_Click" />
                                    <Button x:Name="SaveKeybindsButton" Content="Save Bindings" Visibility="Collapsed" Click="SaveKeybinds_Click" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem x:Name="TabSettings" Header="SETTINGS">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="32,28,32,24">
                            <TextBlock x:Name="SettingsTitleText" Style="{StaticResource PageTitle}" Text="{Binding Header, ElementName=TabSettings}" />
                            <TextBlock x:Name="SettingsAppliedNoteText" Style="{StaticResource PageSubtitle}" Text="" />

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="14" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <GroupBox x:Name="GroupGraphics" Header="Graphics Quality" VerticalAlignment="Top">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Label x:Name="LabelDisplay" Grid.Row="0" Content="Display:" />
                                        <TextBlock x:Name="DetectedDisplayText" Grid.Row="0" Grid.Column="1" TextWrapping="Wrap" FontSize="12"
                                                   Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="8,0,0,0" />
                                        <Label x:Name="LabelResolution" Grid.Row="1" Content="Resolution:" />
                                        <ComboBox x:Name="ResolutionCombo" Grid.Row="1" Grid.Column="1" Margin="8,3,0,3" IsEditable="True" />
                                        <Label x:Name="LabelAspectRatio" Grid.Row="2" Content="Aspect Ratio:" />
                                        <ComboBox x:Name="AspectCombo" Grid.Row="2" Grid.Column="1" Margin="8,3,0,3" />
                                        <Label x:Name="LabelFrameRate" Grid.Row="3" Content="Frame Rate:" />
                                        <ComboBox x:Name="FrameRateCombo" Grid.Row="3" Grid.Column="1" Margin="8,3,0,3" />
                                        <Label x:Name="LabelTextureFiltering" Grid.Row="4" Content="Texture Filtering:" />
                                        <ComboBox x:Name="AnisoCombo" Grid.Row="4" Grid.Column="1" Margin="8,3,0,3" />
                                        <Label x:Name="LabelShadowQuality" Grid.Row="5" Content="Shadow Quality:" />
                                        <ComboBox x:Name="ShadowCombo" Grid.Row="5" Grid.Column="1" Margin="8,3,0,3" />
                                        <CheckBox x:Name="FullscreenCheck" Grid.Row="6" Grid.ColumnSpan="2" Content="Fullscreen" Margin="0,8,0,4" />
                                        <CheckBox x:Name="SmaaCheck" Grid.Row="7" Grid.ColumnSpan="2" Content="SMAA anti-aliasing" />
                                        <CheckBox x:Name="FpsOverlayCheck" Grid.Row="8" Grid.ColumnSpan="2" Content="FPS Overlay" />
                                    </Grid>
                                </GroupBox>

                                <StackPanel Grid.Column="2">
                                    <GroupBox x:Name="GroupControlsSettings" Header="Controls">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Label x:Name="LabelGameLanguage" Grid.Row="0" Content="Game Language:" />
                                            <ComboBox x:Name="LanguageCombo" Grid.Row="0" Grid.Column="1" Margin="8,3,0,3" />
                                            <Label x:Name="LabelLauncherLanguage" Grid.Row="1" Content="Launcher Language:" />
                                            <ComboBox x:Name="LauncherLanguageCombo" Grid.Row="1" Grid.Column="1" Margin="8,3,0,3"
                                                      SelectionChanged="LauncherLanguageCombo_SelectionChanged" />
                                            <Label Grid.Row="2" Padding="0,6,8,6">
                                                <TextBlock x:Name="LabelButtonGlyphs" Text="Button glyphs:" />
                                            </Label>
                                            <ComboBox x:Name="GlyphFamilyCombo" Grid.Row="2" Grid.Column="1" Margin="8,3,0,3" />
                                            <CheckBox x:Name="ControllerFixCheck" Grid.Row="3" Grid.ColumnSpan="2" Margin="0,8,0,4"
                                                      Content="Use SDL controller backend (Xbox / PlayStation controllers)" />
                                            <CheckBox x:Name="PortableCheck" Grid.Row="4" Grid.ColumnSpan="2"
                                                      Content="Portable mode: keep saves and settings in the game folder" />
                                            <CheckBox x:Name="LoggingEnabledCheck" Grid.Row="5" Grid.ColumnSpan="2" IsChecked="False"
                                                      Content="Detailed logging (troubleshooting; larger log files)" />
                                        </Grid>
                                    </GroupBox>
                                    <Grid>
                                        <Button x:Name="ApplyRecommendedButton" Content="Reset to Recommended" HorizontalAlignment="Left" Click="ApplyRecommended_Click" />
                                        <Button x:Name="SaveSettingsButton" Content="Save Settings" Visibility="Collapsed" Click="SaveSettings_Click" />
                                    </Grid>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem x:Name="TabUpdates" Header="UPDATES">
                    <Grid Margin="32,28,32,24">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock x:Name="UpdatesTitleText" Style="{StaticResource PageTitle}" Text="Check for Updates" />
                        <TextBlock x:Name="UpdateVersionText" Grid.Row="1" Style="{StaticResource PageSubtitle}" Text="" />
                        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,10">
                            <Button x:Name="CheckUpdatesButton" Content="Check for Updates" Margin="0,0,10,0" Click="CheckUpdates_Click" />
                            <Button x:Name="DownloadUpdateButton" Style="{StaticResource PrimaryButton}" Content="Download &amp; Install"
                                    Visibility="Collapsed" Click="DownloadUpdate_Click" />
                        </StackPanel>
                        <ProgressBar x:Name="DownloadProgress" Grid.Row="3" Visibility="Collapsed" Margin="0,0,0,10" />
                        <TextBox x:Name="UpdateStatusText" Grid.Row="4" IsReadOnly="True" TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto" Background="{StaticResource BackgroundPanel}"
                                 BorderBrush="{StaticResource BorderBrush}" Padding="12" />
                    </Grid>
                </TabItem>

            </TabControl>
        </Grid>
    </Grid>
</Window>
